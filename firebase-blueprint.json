{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile, account, wallpapers, and DND settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "status": { "type": "string" },
        "wallpaperId": { "type": "string" },
        "customWallpaperUrl": { "type": "string" },
        "wallpaperDim": { "type": "number" },
        "doNotDisturb": { "type": "boolean" },
        "dndDuration": { "type": "string" },
        "aiModeEnabled": { "type": "boolean" }
      },
      "required": ["id", "name", "username"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Conversations and friends / acquaintances",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "type": { "type": "string" },
        "lastMessageText": { "type": "string", "maxLength": 1000 },
        "lastMessageTime": { "type": "string" },
        "unreadCount": { "type": "number" }
      },
      "required": ["id", "name", "type"]
    },
    "MarketplaceProduct": {
      "title": "Marketplace Product",
      "description": "Purchases and items for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 100 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "title", "price", "sellerId"]
    },
    "GameScore": {
      "title": "Game Score",
      "description": "User game scores in waiting room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "gameName": { "type": "string", "maxLength": 50 },
        "score": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "gameName", "score"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "User chats and conversations"
    },
    "/marketplaceProducts/{productId}": {
      "schema": { "$ref": "#/entities/MarketplaceProduct" },
      "description": "Marketplace products for purchase/sale"
    },
    "/gameScores/{scoreId}": {
      "schema": { "$ref": "#/entities/GameScore" },
      "description": "Game scores"
    }
  }
}
